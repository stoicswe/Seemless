diff --git a/include/vkd3d_sonames.h b/include/vkd3d_sonames.h
index 1b56123..4d3a7f8 100644
--- a/include/vkd3d_sonames.h
+++ b/include/vkd3d_sonames.h
@@ -28,8 +28,11 @@
 #define SONAME_LIBVULKAN "libvulkan.so.1"
 #define SONAME_D3D12CORE "libvkd3d-proton-d3d12core.so"
 #elif defined(__APPLE__)
-#define SONAME_LIBVULKAN "libvulkan.1.dylib"
-#define SONAME_D3D12CORE "vkd3d-proton-d3d12core.dylib"
+/* Seemless: no Vulkan loader; MoltenVK is installed next to these libraries
+ * and used directly (VKD3D_VULKAN_LIBRARY overrides, e.g. a loader + ICD).
+ * @loader_path resolves against the dlopen caller's directory. */
+#define SONAME_LIBVULKAN "@loader_path/libMoltenVK.dylib"
+#define SONAME_D3D12CORE "@loader_path/libvkd3d-proton-d3d12core.dylib"
 #else
 #error "Unrecognized platform."
 #endif
