+static std::atomic<id<MTLBuffer>> _mvkNullDescriptorMTLBuffer{nil};
+static std::mutex _mvkNullDescriptorMTLBufferLock;
+
+id<MTLBuffer> mvkGetNullDescriptorMTLBuffer() {
+	return _mvkNullDescriptorMTLBuffer.load(std::memory_order_acquire);
+}
+
+// Created once per process (Apple silicon has one GPU) and never released.
+static id<MTLBuffer> mvkCreateNullDescriptorMTLBuffer(id<MTLDevice> mtlDevice) {
+	lock_guard<mutex> lock(_mvkNullDescriptorMTLBufferLock);
+	id<MTLBuffer> buf = _mvkNullDescriptorMTLBuffer.load(std::memory_order_relaxed);
+	if ( !buf ) {
+		@autoreleasepool {
+			// Shared storage is zero-filled on creation.
+			buf = [mtlDevice newBufferWithLength: 64 * KIBI options: MTLResourceStorageModeShared];	// retained
+			buf.label = @"Seemless null descriptor buffer";
+		}
+		_mvkNullDescriptorMTLBuffer.store(buf, std::memory_order_release);
+	}
+	return buf;
+}
